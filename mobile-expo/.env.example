# Configuração pública do seu aplicativo Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Endereço HTTPS do backend usado pelo aplicativo.
EXPO_PUBLIC_MONIMOB_API_URL=
# Local emulators: use http://YOUR_COMPUTER_LAN_IP:5001/demo-monimob/southamerica-east1/monimobApi
# Use only for local development. Never set in a production build.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=YOUR_COMPUTER_LAN_IP
